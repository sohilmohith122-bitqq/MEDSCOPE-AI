{
  "name": "medcare",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "prisma": { "schema": "db/schema.prisma" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "db:migrate": "prisma migrate dev --schema db/schema.prisma",
    "db:seed": "tsx db/seed.ts",
    "db:generate": "prisma generate --schema db/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@tanstack/react-query": "5.59.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-flow-renderer": "10.3.17",
    "react-pdf": "9.1.0",
    "reactflow": "11.11.4",
    "recharts": "2.13.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}